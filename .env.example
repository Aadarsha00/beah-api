DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_TIME_ZONE=America/New_York
CORS_ALLOWED_ORIGINS=https://www.example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com,https://api.example.com

# HTTPS/reverse proxy. Trust forwarded headers only when a trusted proxy strips
# client-supplied values and sets its own X-Forwarded-Proto header.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_USE_X_FORWARDED_HOST=false
DJANGO_NUM_PROXIES=

# Start HSTS at 0, verify HTTPS everywhere, then increase gradually.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Persistent uploaded-media storage. For FileSystemStorage this must be an
# absolute durable mount outside an ephemeral release directory.
DJANGO_DEFAULT_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
DJANGO_DEFAULT_STORAGE_OPTIONS={}
DJANGO_MEDIA_ROOT=/absolute/persistent/path/to/media
DJANGO_MEDIA_URL=/media/
DJANGO_STATIC_ROOT=/absolute/path/to/release/staticfiles
DJANGO_STATIC_URL=/static/

# Customer account activation email
SEND_ACTIVATION_EMAIL=true
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Beautiful Brows & Henna <no-reply@example.com>
EMAIL_FRONTEND_DOMAIN=beautifulbrowsandhenna.com
EMAIL_FRONTEND_PROTOCOL=https
EMAIL_FRONTEND_SITE_NAME=Beautiful Brows & Henna
SEND_CONTACT_EMAILS=true
ADMIN_EMAIL=owner@example.com

# MySQL is required in production so concurrent booking checks use row locks.
DB_ENGINE=mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_SSL_CA=

# API abuse limits. Throttle counters live in the default cache, so a
# per-process cache multiplies every limit by the worker count. Production must
# set exactly one of DJANGO_CACHE_URL / DJANGO_CACHE_TABLE, or explicitly accept
# per-process limits with DJANGO_ALLOW_LOCAL_MEMORY_CACHE=true.
ANON_THROTTLE_RATE=100/hour
USER_THROTTLE_RATE=1000/hour
CONTACT_THROTTLE_RATE=5/hour

# Redis, e.g. redis://127.0.0.1:6379/1
DJANGO_CACHE_URL=
# Database-backed cache table name. Requires: manage.py createcachetable
DJANGO_CACHE_TABLE=django_cache
DJANGO_ALLOW_LOCAL_MEMORY_CACHE=false

# Error monitoring. Unhandled 500s are always emailed to ADMIN_EMAIL. Sentry is
# optional and additional; setting a DSN requires `pip install sentry-sdk`.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

DJANGO_LOG_LEVEL=INFO
